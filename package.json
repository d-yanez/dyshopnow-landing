{
  "name": "dyshopnow-landing",
  "version": "1.0.0",
  "description": "Landing SEO Dyshopnow",
  "main": "src/app.js",
  "scripts": {
    "start": "node src/app.js",
    "dev": "nodemon src/app.js",
    "tailwind:watch": "npx tailwindcss -i ./public/css/styles.css -o ./public/css/output.css --watch",
    "dev:local": "concurrently \"npm run tailwind:watch\" \"npm run dev\"",
    "tailwind:build": "NODE_ENV=production npx tailwindcss -i ./public/css/styles.css -o ./public/css/output.css --minify"
  },
  "dependencies": {
    "compression": "^1.8.0",
    "ejs": "^3.1.8",
    "express": "^4.18.2",
    "express-static-gzip": "^3.0.0",
    "nocache": "^4.0.0"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.2.0",
    "nodemon": "^3.1.10",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17"
  }
}
