<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= seo.title %></title>
    <meta name="description" content="<%= seo.description %>" />
    <link href="/css/output.css" rel="stylesheet" />
      <!-- Schema.org JSON-LD -->
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "ItemList",
      "itemListElement": [
        <% category.products.forEach((product, i) => { %>
        {
          "@type": "ListItem",
          "position": <%= i + 1 %>,
          "item": {
            "@type": "Product",
            "name": "<%= product.name.replace(/"/g,'\\"') %>",
            "image": "<%= product.image.replace(/\.(jpe?g|png)$/, '.webp') %>",
            "description": "<%= product.description.replace(/"/g,'\\"') %>",
            "sku": "<%= product.sku %>",
            "brand": {
              "@type": "Thing",
              "name": "<%= category.name %>"
            },
            "offers": {
              "@type": "Offer",
              "url": "<%= product.url %>",
              "priceCurrency": "CLP",
              "price": "<%= product.price %>",
              "availability": "https://schema.org/InStock"
            }
          }
        }<%= (i < category.products.length - 1) ? ',' : '' %>
        <% }) %>
      ]
    }
    </script>
</head>

  </head>
  <body class="bg-white text-gray-800">
    <!-- HEADER -->
    <%- include('partials/header') %>

    <!-- BANNER -->
    <section class="relative">
       <picture>
         <source
           srcset="<%= category.banner.replace(/\.(jpe?g|png)$/, '.webp') %>"
           type="image/webp"
         />
         <img
           src="<%= category.banner %>"
           alt="<%= category.name %>"
           loading="lazy"
           class="w-full h-64 object-cover"
         />
       </picture>
      
      <div class="absolute inset-0 bg-black bg-opacity-50 flex items-center justify-center">
        <h1 class="text-3xl md:text-5xl text-white font-bold"><%= category.name %></h1>
      </div>
    </section>

    <!-- PRODUCTOS -->
    <main class="p-4 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
      <% category.products.forEach(product => { %>
        <div class="w-full rounded-2xl overflow-hidden shadow-md transition-transform duration-300 ease-in-out hover:scale-[1.03] hover:shadow-lg">
          <!-- Imagen con efecto hover -->
          <div class="overflow-hidden rounded-2xl">
            <picture>
             <source
               srcset="<%= product.image.replace(/\.(jpe?g|png)$/, '.webp') %>"
               type="image/webp"
             />
              <img src="<%= product.image %>" 
                alt="<%= product.name %>" 
                loading="lazy"
                class="w-full object-contain bg-white block transition-transform duration-500 ease-in-out hover:scale-110"/>
            </picture>
          </div>

          <!-- Contenido -->
          <div class="p-4">
            <h2 class="text-lg font-bold mb-2"><%= product.name %></h2>
            <p class="text-sm text-gray-600 mb-1">SKU: <%= product.sku %></p>
            <p class="text-sm mb-2 text-gray-800">$<%= product.price.toLocaleString() %></p>
            <% if (product.tag) { %>
              <span class="inline-block bg-green-500 text-white text-xs px-2 py-1 rounded-full"><%= product.tag %></span>
            <% } %>
            <p class="text-sm mt-2 mb-4"><%= product.description %></p>
            <!-- Botón con glow -->
            <div class="flex justify-center">
              <a href="<%= product.url %>?utm_source=landing&utm_medium=button&utm_campaign=dyshopnow" target="_blank"
                class="inline-block bg-blue-600 text-white font-semibold px-4 py-2 rounded-lg shadow-md transition-all duration-300 ease-in-out
                      hover:bg-blue-700 hover:shadow-xl hover:shadow-blue-400/50 hover:-translate-y-1 hover:scale-105 active:scale-95">
                Ver producto
              </a>
            </div>
          </div>
        </div>
      <% }) %>
    </main>

    <!-- FOOTER -->
    <%- include('partials/footer') %>

    <!-- JS MENU -->
    <script src="/js/menu.js" defer></script>
  </body>
</html>
