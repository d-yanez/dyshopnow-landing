<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= seo.title %></title>
    <meta name="description" content="<%= seo.description %>" />
    <link href="/css/output.css" rel="stylesheet" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type"        content="<%= pageType || 'website' %>" />
    <meta property="og:url"         content="https://landing.dyshopnow.cl<%= request.originalUrl %>" />
    <meta property="og:title"       content="<%= seo.title %>" />
    <meta property="og:description" content="<%= seo.description %>" />
    <meta property="og:image"       content="<%= ogImage %>" />

    <!-- Twitter Card -->
    <meta name="twitter:card"        content="summary_large_image" />
    <meta name="twitter:url"         content="https://landing.dyshopnow.cl<%= request.originalUrl %>" />
    <meta name="twitter:title"       content="<%= seo.title %>" />
    <meta name="twitter:description" content="<%= seo.description %>" />
    <meta name="twitter:image"       content="<%= ogImage %>" />
  </head>
  <body class="bg-white text-gray-800">
    <!-- HEADER -->
    <%- include('partials/header') %>

    <!-- MAIN: catálogo de categorías -->
    <main class="p-4 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
      <% categories.forEach(category => { %>
        <div class="w-full rounded-2xl overflow-hidden shadow-md hover:shadow-xl transform hover:scale-105 transition duration-300 ease-in-out">
          <div class="overflow-hidden rounded-2xl">
            <picture>
              <source
                srcset="https://storage.googleapis.com/dyshopnow-landing-assets/catalog/<%= category.slug %>.webp"
                type="image/webp"
              />
              <img
                src="https://storage.googleapis.com/dyshopnow-landing-assets/catalog/<%= category.slug %>.jpg"
                alt="<%= category.name %>"
                loading="lazy"
                class="w-full object-contain bg-white block transform transition-transform duration-300 ease-in-out hover:scale-105"
              />
            </picture>
          </div>
          <div class="p-4">
            <h2 class="text-lg font-bold mb-2"><%= category.name %></h2>
            <p class="text-sm mb-4"><%= category.seo.description %></p>
            <div class="flex justify-center">
              <a
                href="/category/<%= category.slug %>"
                class="inline-block bg-blue-600 text-white px-4 py-2 rounded-lg shadow-md transform transition-all duration-300 ease-in-out
                       hover:bg-blue-700 hover:shadow-xl hover:shadow-blue-400/50 hover:-translate-y-1 hover:scale-105 active:scale-95"
              >
                Ver productos
              </a>
            </div>
          </div>
        </div>
      <% }) %>
    </main>

    <!-- FOOTER -->
    <footer class="bg-gray-100 text-center p-4 mt-8 text-gray-500">
      &copy; 2025 Dyshopnow. Todos los derechos reservados.
    </footer>

    <!-- JS menú -->
    <script src="/js/menu.js" defer></script>
  </body>
</html>