<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= seo.title %></title>
  <meta name="description" content="<%= seo.description %>" />
  <link href="/css/output.css" rel="stylesheet" />
</head>
<body class="bg-white text-gray-800">

  <!-- HEADER -->
  <header class="bg-black text-white p-4 flex justify-between items-center relative">
    <div class="flex items-center space-x-4">
      <h1 class="text-xl font-bold">Dyshopnow</h1>
    </div>

    <!-- Botón hamburguesa -->
    <button id="menu-btn" class="block md:hidden focus:outline-none">
      <svg
        id="menu-icon"
        class="w-7 h-7 text-white transition-transform duration-300 ease-in-out"
        xmlns="http://www.w3.org/2000/svg"
        fill="currentColor"
        viewBox="0 0 24 24"
      >
        <!-- Icono hamburguesa ☰ -->
        <path d="M4 6h16M4 12h16M4 18h16" />
      </svg>
    </button>

    <!-- Menú -->
    <nav
      id="menu"
      class="hidden flex-col absolute top-full left-0 w-full bg-black md:flex md:flex-row md:space-x-6 md:ml-6 md:static md:bg-transparent z-50 transition-all duration-300 ease-in-out"
    >
      <a href="#" class="block px-4 py-2 md:px-0 md:py-0 hover:bg-gray-800 md:hover:bg-transparent">Home</a>
      <a href="#" class="block px-4 py-2 md:px-0 md:py-0 hover:bg-gray-800 md:hover:bg-transparent">Contáctanos</a>
      <a href="#" class="block px-4 py-2 md:px-0 md:py-0 hover:bg-gray-800 md:hover:bg-transparent">Quiénes somos</a>
    </nav>
  </header>

  <!-- MAIN -->
  <main class="p-4 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
    <% categories.forEach(category => { %>
      <div
        class="w-full rounded-2xl overflow-hidden shadow-md hover:shadow-xl transform hover:scale-105 transition duration-300 ease-in-out"
      >
        <img
          src="<%= category.banner %>"
          alt="<%= category.title %>"
          class="w-full h-48 object-cover block"
        />
        <div class="p-4">
          <h2 class="text-lg font-bold mb-2"><%= category.title %></h2>
          <p class="text-sm mb-4"><%= category.description %></p>
          <a
            href="/<%= category.slug %>"
            class="inline-block bg-blue-600 text-white px-4 py-2 rounded-lg shadow-md hover:bg-blue-700 hover:shadow-lg transition transform hover:scale-105 active:scale-95 duration-300 ease-in-out"
          >
            Ver productos
          </a>
        </div>
      </div>
    <% }) %>
  </main>

  <!-- FOOTER -->
  <footer class="bg-gray-100 text-center p-4 mt-8 text-gray-500">
    &copy; 2025 Dyshopnow. Todos los derechos reservados.
  </footer>

  <!-- SCRIPT -->
  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const menuBtn = document.getElementById('menu-btn');
      const menu = document.getElementById('menu');
      const menuIcon = document.getElementById('menu-icon');

      if (menuBtn && menu && menuIcon) {
        menuBtn.addEventListener('click', () => {
          menu.classList.toggle('hidden');
          menu.classList.toggle('translate-y-0'); // Animación slide
          menuIcon.classList.add('rotate-180'); // Rotación animada

          // Cambia entre ☰ y ✖️
          if (menu.classList.contains('hidden')) {
            menuIcon.innerHTML = '<path d="M4 6h16M4 12h16M4 18h16" />'; // ☰
          } else {
            menuIcon.innerHTML = '<path d="M6 18L18 6M6 6l12 12" />'; // ✖️
          }

          setTimeout(() => menuIcon.classList.remove('rotate-180'), 300);
        });
      }
    });
  </script>
</body>
</html>
